# REAL DATABASE (recommended). For local MongoDB: docker compose up -d
# Copy this file to .env.local. Use your own credentials for Atlas.
DATABASE_MODE=auto
MONGODB_URI=mongodb://127.0.0.1:27017/luxora_estate
MONGODB_DB_NAME=luxora_estate

# Local demo without MongoDB: leave MONGODB_URI= empty (only for development).
# Production requires an actual database; do not use DEMO_MODE=1 for a business.

# Set unique real values before admin login will work.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Brand contact details shown on the public website.
NEXT_PUBLIC_CONTACT_EMAIL=hello@luxora.example
